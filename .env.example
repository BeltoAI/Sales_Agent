# Sales Agent environment variables.
# Copy to .env.local for local development (never commit real values),
# and add the same names in Vercel → Project → Settings → Environment Variables.

# --- Supabase (Phase 2) — Supabase dashboard → Project Settings → API ---
# Project URL, e.g. https://abcdefgh.supabase.co (safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=
# "anon" public key, or the newer "publishable" key (sb_publishable_...). Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key, or the newer "secret" key (sb_secret_...). SERVER ONLY, bypasses RLS. Used by background jobs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mailbox credentials (Phase 3) ---
# 32-byte key that encrypts stored mailbox passwords (AES-256-GCM). Generate: openssl rand -base64 32
# Changing or losing it makes saved mailboxes unreadable (users must reconnect). Also signs unsubscribe links.
ENCRYPTION_KEY=

# --- AI (Phase 4+) ---
# Anthropic API key (console.anthropic.com → API Keys). SERVER ONLY. Used by every agent (planner, researcher, writer, reply sorter).
ANTHROPIC_API_KEY=

# --- Lead data (Phase 4, optional) ---
# Apollo.io MASTER API key. If empty, a clearly labelled demo provider returns fake @example.com people that are never emailed.
APOLLO_API_KEY=

# --- Background jobs + sending (Phase 6) ---
# Random secret (16+ chars) that Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>". Generate: openssl rand -hex 32
CRON_SECRET=
# Public URL of the app, used for unsubscribe links in emails, e.g. https://sales-agent.vercel.app
# (On Vercel it defaults to the production domain; sending is blocked in production if no URL is known.)
APP_URL=
# Emergency off switch for ALL users: set to "true" to stop every send immediately (no redeploy of code needed).
SENDING_DISABLED=
